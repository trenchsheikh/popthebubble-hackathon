# ============================================================================
# Supabase (database, auth, storage)
# ============================================================================

# Public Supabase URL (safe to expose in client bundles, prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase anon key (safe to expose; RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase service role key (SERVER ONLY - never expose to client)
# Used for admin operations that bypass RLS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# App URL for Supabase Auth redirects (used in magic link flow)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# AI / LLM (Fireworks, OpenAI-compatible — powers recommendations, chat,
# profile extraction via lib/llm.ts)
# ============================================================================

# Fireworks API key (SERVER ONLY - never expose to client). Required for lib/llm.ts.
FIREWORKS_API_KEY=fw_...

# Optional: override the OpenAI-compatible base URL (defaults to Fireworks).
# Swap this + the key for any OpenAI-compatible provider.
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Optional: override the default model.
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct

# ============================================================================
# Memory (Mubit) — operational memory via the @mubit-ai/sdk client (lib/mubit.ts)
# ============================================================================

# Mubit API key (SERVER ONLY). Create a project at https://console.mubit.ai
# and copy the key. This is the only var required to enable real memory.
MUBIT_API_KEY=your_mubit_api_key_here

# Optional: override the SDK's default endpoint (leave unset to use Mubit's).
# MUBIT_BASE_URL=

# ============================================================================
# Notifications (Twilio WhatsApp)
# ============================================================================

# Twilio account SID (from https://console.twilio.com)
# SERVER ONLY
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio auth token
# SERVER ONLY
TWILIO_AUTH_TOKEN=your_auth_token

# Twilio WhatsApp sender (sandbox or production number, must include "whatsapp:" prefix)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Restaurant's WhatsApp number that receives orders (must include "whatsapp:" prefix and country code)
RESTAURANT_WHATSAPP_TO=whatsapp:+447700900123

# ============================================================================
# Diagnostics (/diagnostics dashboard)
# ============================================================================

# Gate token for the /diagnostics dashboard. If set, the page requires
# ?key=<this value>. Leave unset only for local dev. SERVER ONLY.
DIAGNOSTICS_TOKEN=

# ============================================================================
# Post-dinner events (/api/events/* + EventDiscovery flow)
# ============================================================================
# All optional — with none set, the flow serves seeded mock London events and
# "Get tickets" opens a search link, so the demo works out of the box. We earn
# affiliate commission on referrals; we never take payment in-app.

# Ticketmaster Discovery API key (SERVER ONLY). Free tier ~5k calls/day. Enables
# real nearby events. https://developer.ticketmaster.com
TICKETMASTER_API_KEY=

# SeatGeek Platform client id (SERVER ONLY). Required to fetch SeatGeek events.
# https://platform.seatgeek.com
SEATGEEK_CLIENT_ID=

# Affiliate / partner ids (optional) — used to tag the outbound "Get tickets"
# links so referred sales are attributed and earn commission.
#   SeatGeek: appended as the documented `aid` query param (real commission).
#   Ticketmaster: real commission uses network-generated Impact/Partnerize
#   links; we attach this as a `camefrom` tag for attribution.
SEATGEEK_AFFILIATE_ID=
TICKETMASTER_AFFILIATE_ID=

# Gate token for the /dashboard restaurant view (same pattern as
# DIAGNOSTICS_TOKEN). Leave unset only for local dev. SERVER ONLY.
DASHBOARD_TOKEN=
